---
import AiIcon from './AiIcon.astro';
import AiDialog from './AiDialog.astro';
import spriteUrl from '../assets/icons.svg?url';
import doubaoUrl from '../assets/doubao.png?url';
import type { DirectProvider, PasteProvider, Labels, MarkdownItem } from '../types.js';
import { resolveName } from '../config.js';
interface Props {
  mdHref: string; mdUrl: string; prompt: string;
  labels: Labels;
  markdownItems: MarkdownItem[];
  direct: DirectProvider[] | false;
  paste: PasteProvider[] | false;
  dialogTitle: string;
  hint1: string;
  lang: string;
}
const { mdHref, mdUrl, prompt, labels, markdownItems, direct, paste, dialogTitle, hint1, lang } = Astro.props;
const enc = encodeURIComponent(prompt);
const renderHref = (tpl: string) => tpl.replaceAll('{prompt}', enc).replaceAll('{url}', encodeURIComponent(mdUrl));
const itemLabel: Record<MarkdownItem, string> = { view: labels.view, copyContent: labels.copyContent, copyUrl: labels.copyUrl, copyPrompt: labels.copyPrompt };
// 菜单图标 sprite id（v5 同款：view=ic-external、copyContent=ic-copy、copyUrl=ic-link、copyPrompt=ic-commentAlt）
const itemIcon: Record<MarkdownItem, string> = { view: 'ic-external', copyContent: 'ic-copy', copyUrl: 'ic-link', copyPrompt: 'ic-commentAlt' };
// spec §8：direct/paste 空数组或 false 视同关组；三组全关 → 整条按钮行不渲染（sr-only 播报区随之不渲染）
const hasAnyGroup = markdownItems.length > 0 || (direct !== false && direct.length > 0) || (paste !== false && paste.length > 0);
---
{hasAnyGroup && (
<div class="page-actions-bar print:hidden" data-copy-success={labels.copySuccess} data-copy-fail={labels.copyFail}>
  {markdownItems.length > 0 && (
    <details class="pa-md" data-md-href={mdHref} data-md-url={mdUrl} data-prompt={prompt}>
      <summary class="pa-btn" aria-label={labels.mdMenu}>
        <svg aria-hidden="true"><use href={`${spriteUrl}#ic-markdown`}></use></svg>
        <span class="pa-label">{labels.mdMenu}</span>
        <svg class="pa-caret" aria-hidden="true"><use href={`${spriteUrl}#ic-caret`}></use></svg>
      </summary>
      <div class="pa-md-menu">
        {markdownItems.map((item) => item === 'view' ? (
          <a class="pa-md-item" href={mdHref} target="_blank" rel="noopener noreferrer" data-ai-action="view" data-action-url={mdHref}>
            <svg aria-hidden="true"><use href={`${spriteUrl}#${itemIcon[item]}`}></use></svg><span>{labels.view}</span>
          </a>
        ) : (
          <button type="button" class="pa-md-item" data-copy={item} data-ai-action={item}>
            <svg aria-hidden="true"><use href={`${spriteUrl}#${itemIcon[item]}`}></use></svg><span>{itemLabel[item]}</span>
          </button>
        ))}
      </div>
    </details>
  )}
  {direct && direct.map((p) => (
    p.style === 'combine' ? (
      <a class="pa-btn pa-combine" href={renderHref(p.href)} target="_blank" rel="noopener noreferrer" data-ai-action="open" data-provider={resolveName(p.name, lang)} aria-label={resolveName(p.name, lang)}>
        {/* scale=1 + bg=transparent：锁标裸标 20px（抵消 AiIcon 默认 0.75 缩放与 #fff 白底，v5 形态） */}
        <AiIcon icon={p.icon} iconUrl={p.iconUrl} size={20} scale={1} bg="transparent" /><span class="pa-combine-text">{resolveName(p.name, lang)}</span>
      </a>
    ) : (
      <a class="pa-btn pa-ai pa-ai-round" href={renderHref(p.href)} target="_blank" rel="noopener noreferrer" data-ai-action="open" data-provider={resolveName(p.name, lang)} aria-label={resolveName(p.name, lang)}>
        <AiIcon icon={p.icon} iconUrl={p.iconUrl} size={40} bg={p.bg} scale={p.scale} ring={p.ring} />
      </a>
    )
  ))}
  {paste && paste.length > 0 && (
    <button type="button" class="pa-btn pa-ai pa-ai-round" data-prompt={prompt} aria-haspopup="dialog" aria-label={labels.pasteOpen} data-ai-action="open">
      {/* paste 圆钮 v5 形态=6 头像叠成一钮（pa-ai-icons > pa-av×N，lobe IconAvatar 规格），
          照 v5 视觉抄；按钮本体的 DOM 契约不变。dialog 内全排由 Task 8 承担 */}
      <span class="pa-ai-icons" aria-hidden="true">
        {paste.map((m) => {
          const src = m.iconUrl ?? (m.icon === 'doubao' ? doubaoUrl : undefined);
          return (
            <span class:list={['pa-av', { 'pa-av-ring-light': m.ring === 'light', 'pa-av-ring-dark': m.ring === 'dark' }]} style={`background:${m.bg ?? '#fff'}`}>
              {src ? (
                <img src={src} alt="" decoding="async" style={`transform:scale(${m.scale ?? 0.75})`} />
              ) : (
                <svg class="pa-av-svg" style={`transform:scale(${m.scale ?? 0.75})`}>
                  <use href={`${spriteUrl}#ic-${m.icon}`}></use>
                </svg>
              )}
            </span>
          );
        })}
      </span>
    </button>
  )}
  {/* 屏幕阅读器播报区（v5 同款，Task 9 脚本 root.querySelector('.pa-live') 依赖） */}
  <span class="sr-only pa-live" aria-live="polite" aria-atomic="true"></span>
</div>
)}
{/* AiDialog 与客户端 <script> 随本组件自带（2026-10-22 自 PageTitle 下移）：
     覆盖 PageTitle 的消费方按文档渲染 AiActionsBar 即得全功能（复制键+对话框+事件），
     无需再碰插件内部。dialog 与 bar 在 DOM 上同级，脚本以 root.parentElement 查找。 */}
{hasAnyGroup && paste !== false && paste.length > 0 && (
  <AiDialog prompt={prompt} labels={labels} paste={paste} hint1={hint1} title={dialogTitle} lang={lang} />
)}

<script>
  // 客户端行为（v5 PageTitle 脚本移植，2026-10-22 随 AiDialog 一并下移进本组件）：
  // 四项复制 + dialog 开合 + 每次动作派发 ai-actions 事件。
  // 状态文案读 DOM data 属性（bar root data-copy-success/fail、dialog .pa-ai-status data-ok/fail），零硬编码。
  import { dispatchAiAction } from '../events.js';

  // 页面上至多一个实例（AiActionsBar 注入），仍按多实例接线以防将来复用。
  for (const root of document.querySelectorAll<HTMLElement>('.page-actions-bar')) {
    const live = root.querySelector<HTMLElement>('.pa-live');
    const page = () => ({ url: location.href, title: document.title });
    const copyText = async (text: string): Promise<boolean> => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // 兜底：非安全上下文/权限拒绝时走 execCommand
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        } catch {
          return false;
        }
      }
    };

    // Markdown 合并下拉：外点/Esc 收合 + 三项复制
    const mdMenu = root.querySelector<HTMLDetailsElement>('details.pa-md');
    if (mdMenu) {
      // 「查看 Markdown 文件」是 <a>（无 data-copy），单独接线；派发后照常导航
      const viewLink = mdMenu.querySelector<HTMLAnchorElement>('a.pa-md-item');
      viewLink?.addEventListener('click', () => {
        dispatchAiAction({ type: 'markdown', action: 'view', url: mdMenu.dataset.mdHref, page: page() });
      });
      // 连点竞态防护：旧定时器晚于新点击触发时会把「已复制 ✓」当原文恢复回去（卡死在成功态）——
      // 原文只在首次点击记录（dataset.origText），新点击清掉旧 timer
      const copyTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
      for (const item of mdMenu.querySelectorAll<HTMLButtonElement>('.pa-md-item[data-copy]')) {
        item.addEventListener('click', async () => {
          const kind = item.dataset.copy;
          // data-copy 值域=MarkdownItem 枚举（copyContent/copyUrl/copyPrompt），事件 action 同名
          const action = kind === 'copyContent' || kind === 'copyUrl' || kind === 'copyPrompt' ? kind : null;
          if (!action) return;
          dispatchAiAction({ type: 'markdown', action, url: mdMenu.dataset.mdHref, page: page() });
          let text = '';
          if (action === 'copyContent') {
            try {
              const res = await fetch(mdMenu.dataset.mdHref!);
              if (res.ok) text = await res.text();
            } catch {
              text = '';
            }
          } else if (action === 'copyUrl') {
            text = mdMenu.dataset.mdUrl ?? '';
          } else {
            text = mdMenu.dataset.prompt ?? '';
          }
          const ok = Boolean(text) && (await copyText(text));
          const okText = root.dataset.copySuccess ?? '';
          const failText = root.dataset.copyFail ?? '';
          const label = item.querySelector<HTMLElement>('span') ?? item;
          if (!label.dataset.origText) label.dataset.origText = label.textContent ?? '';
          const prevTimer = copyTimers.get(label);
          if (prevTimer) clearTimeout(prevTimer);
          label.textContent = ok ? okText : failText;
          if (live) live.textContent = ok ? okText : failText;
          copyTimers.set(
            label,
            setTimeout(() => {
              label.textContent = label.dataset.origText ?? '';
              delete label.dataset.origText;
              copyTimers.delete(label);
              if (live) live.textContent = '';
            }, 1600),
          );
        });
      }
      document.addEventListener('click', (e) => {
        if (mdMenu.open && !mdMenu.contains(e.target as Node)) mdMenu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mdMenu.open) mdMenu.open = false;
      });
    }

    // direct 直跳按钮（<a>）：派发后照常导航，不 preventDefault
    for (const btn of root.querySelectorAll<HTMLAnchorElement>('a[data-ai-action="open"]')) {
      btn.addEventListener('click', () => {
        dispatchAiAction({ type: 'direct', action: 'open', provider: btn.dataset.provider, page: page() });
      });
    }

    // AI 按钮：prompt 全文 → 剪贴板 + 弹 dialog
    const dialog = root.parentElement?.querySelector<HTMLDialogElement>('dialog.pa-ai-dialog');
    if (dialog) {
      const status = dialog.querySelector<HTMLElement>('.pa-ai-status');
      for (const aiBtn of root.querySelectorAll<HTMLButtonElement>('button.pa-ai')) {
        aiBtn.addEventListener('click', async () => {
          dispatchAiAction({ type: 'paste', action: 'open', page: page() });
          // 先开 modal（反馈即时）再复制写状态；防重复 showModal 抛 InvalidStateError
          if (!dialog.open) dialog.showModal();
          const ok = await copyText(aiBtn.dataset.prompt ?? '');
          if (status) {
            status.textContent = ok ? status.dataset.ok! : status.dataset.fail!;
          }
        });
      }
      // dialog 内模型钮：派发后照常导航，不 preventDefault
      for (const model of dialog.querySelectorAll<HTMLAnchorElement>('a[data-ai-action="open"]')) {
        model.addEventListener('click', () => {
          dispatchAiAction({ type: 'paste', action: 'open', provider: model.dataset.provider, page: page() });
        });
      }
      // 点遮罩关闭（Esc 原生支持）：判断点击坐标在 dialog 矩形外即视为遮罩
      dialog.addEventListener('click', (e) => {
        const r = dialog.getBoundingClientRect();
        const inDialog =
          e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
        if (!inDialog) dialog.close();
      });
      dialog.querySelector<HTMLButtonElement>('.pa-ai-close')?.addEventListener('click', () => dialog.close());
    }
  }
</script>

<style>
  @layer starlight.core {
    .page-actions-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 0.75rem;
      margin-top: 0.75rem;
    }
    /* 控件族 ghost 风格：透明底灰字、hover accent，安静不抢眼 */
    .pa-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.5rem;
      border: 0;
      border-radius: 0.375rem;
      background: none;
      color: var(--sl-color-gray-2);
      font-family: inherit;
      font-size: var(--sl-text-sm);
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
    }
    .pa-btn:is(:hover, :focus-visible) {
      color: var(--sl-color-accent-high);
    }
    .pa-btn svg {
      width: 1rem;
      height: 1rem;
    }
    /* Markdown 合并下拉（2026-10-08）：details/summary 原生开合 + JS 外点收合 */
    .pa-md {
      position: relative;
    }
    .pa-md > summary {
      list-style: none;
      cursor: pointer;
    }
    .pa-md > summary::-webkit-details-marker {
      display: none;
    }
    .pa-caret {
      width: 0.75rem !important;
      height: 0.75rem !important;
      opacity: 0.7;
    }
    .pa-md-menu {
      position: absolute;
      top: calc(100% + 0.25rem);
      inset-inline-start: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      min-width: 17rem;
      max-width: calc(100vw - 2rem);
      padding: 0.25rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.375rem;
      background-color: var(--sl-color-bg-nav);
      box-shadow: var(--sl-shadow-md);
    }
    .pa-md-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0.625rem;
      border: 0;
      border-radius: 0.25rem;
      background: none;
      color: var(--sl-color-gray-2);
      font-family: inherit;
      font-size: var(--sl-text-sm);
      text-align: start;
      text-decoration: none;
      cursor: pointer;
    }
    .pa-md-item:is(:hover, :focus-visible) {
      background-color: var(--sl-color-bg);
      color: var(--sl-color-accent-high);
    }
    .pa-md-item svg {
      width: 1rem;
      height: 1rem;
      flex: none;
    }

    /* ChatGPT/Claude 锁标（lobe DOM 同构）：图标 + 品牌名 span，字号比例取自 lobe
       （文字 = 图标×0.75×0.95、w600、line-height 1）；图标-文字间距 0.375rem
       （lobe 原比 0.1×size≈1.8px 太紧，2026-10-08 用户反馈不能紧挨） */
    .pa-combine {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }
    .pa-combine-text {
      font-size: 0.8rem;
      line-height: 1;
      font-weight: 600;
    }

    /* AI 按钮头像（lobe IconAvatar 规格）：品牌底色容器 + 图标 scale；
       圆=50%、方=0.125rem（方形方案注释存档） */
    .pa-ai-icons {
      display: inline-flex;
      align-items: center;
      gap: 0.125rem;
    }
    .pa-av {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.375rem;
      height: 1.375rem;
      overflow: hidden;
      flex: none;
    }
    .pa-ai-round .pa-av {
      border-radius: 50%;
    }
    .pa-ai-square .pa-av {
      border-radius: 0.125rem;
    }
    .pa-av-ring-light {
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05) inset;
    }
    .pa-av-ring-dark {
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    }
    .pa-av svg.pa-av-svg,
    .pa-av img {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* AiIcon（pa-icon-*）输出对位 v5 形态：combine 锁标图标=v5 svg.pa-combine-ic 的
       1.125rem（位图=v5 img.pa-ai-ic 裸标形态：20px、radius 0.1875rem、无白底无 ring）；
       头像圆钮（direct round/square）图标/位图=v5 .pa-av 同规格（圆角+inset ring）。
       AiIcon 是独立子组件，其根元素不带本组件 scope 属性（同 AiDialog 实测），
       scoped 选择器够不到——:global() 只在 .pa-combine / .pa-ai 语境内放行 */
    .pa-combine :global(.pa-icon-svg) {
      width: 1.125rem;
      height: 1.125rem;
      flex: none;
    }
    .pa-combine :global(img.pa-icon-img) {
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      border-radius: 0.1875rem;
      box-shadow: none;
    }
    .pa-ai > :global(.pa-icon-svg) {
      width: 2.5rem;
      height: 2.5rem;
    }
    .pa-ai :global(img.pa-icon-img) {
      display: block;
      border-radius: 50%;
    }
    .pa-ai :global(img.pa-icon-img[data-ring='light']) {
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05) inset;
    }
    .pa-ai :global(img.pa-icon-img[data-ring='dark']) {
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    }

    /* 窄屏：文字标签隐藏（aria-label 兜底），图标稍放大保可点性。 */
    @media (max-width: 40rem) {
      .pa-label {
        display: none;
      }
      .pa-btn {
        padding: 0.375rem;
      }
      .pa-btn svg,
      .pa-md-item svg {
        width: 1.125rem;
        height: 1.125rem;
      }
    }
  }
</style>
